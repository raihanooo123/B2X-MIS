APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Reverse proxies / load balancers whose X-Forwarded-For header is trusted:
# comma-separated IP addresses or CIDR ranges (e.g. 10.0.0.0/16,192.168.1.10).
# Empty (the default) trusts none, which is correct when nothing sits in front of the app.
# PRODUCTION MUST list the real proxy/load-balancer addresses, or terms acceptance
# records the balancer's IP instead of the applicant's (02 §25.10). Never use "*":
# it lets any client choose its own recorded IP by sending X-Forwarded-For.
TRUSTED_PROXIES=

# Separate from APP_KEY; use a random secret of at least 32 characters.
# Keep old key versions available for the audit log's retention period.
AUDIT_IDENTIFIER_KEY=
AUDIT_IDENTIFIER_KEY_VERSION=v1

# Sanctum (06 §1, 05.13 §6.1): hosts whose browser requests to /api are
# first-party and get the session. Defaults cover localhost, 127.0.0.1:8000
# and APP_URL's host; add any other host:port the app is served on
# (e.g. localhost:8888 under MAMP), or the order pad's API calls run as a guest.
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8888,127.0.0.1,127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 05.12 §6.1 — production mail is Postmark: MAIL_MAILER=postmark.
POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=outbound
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 07 §6.4 — Stripe card payments. Placeholders only: never commit real keys.
# STRIPE_KEY is the publishable key (pk_...), STRIPE_SECRET the secret key
# (sk_...), STRIPE_WEBHOOK_SECRET the signing secret (whsec_...) of the
# endpoint pointed at /api/v1/webhooks/stripe.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
